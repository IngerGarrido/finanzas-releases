# Copia este archivo a .env y ajusta los valores.

DB_HOST=localhost
DB_NAME=finanzas_personales
DB_USER=tu_usuario
DB_PASS=tu_password

# En producción usa APP_ENV=production y APP_DEBUG=false.
# (En producción el debug queda forzado a off aunque esto diga true.)
APP_ENV=production
APP_DEBUG=false

# Dominio(s) permitidos para CORS (separa con coma si hay varios).
CORS_ORIGIN=https://tudominio.cl

LOG_LEVEL=info
LOG_FILE=logs/app.log

CACHE_DRIVER=file
CACHE_TTL=300
